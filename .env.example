# ---------- Front end (public — bundled into the website) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Leave empty when the API server serves the website (same origin). Otherwise e.g. https://api.yourcollege.app
VITE_API_URL=

# ---------- API server (secret — NEVER prefix with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=8787
# Comma-separated origins allowed to call the API from another domain (only needed if front end is hosted elsewhere)
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=60

# ---------- Online payments (server only — never prefix with VITE_) ----------
# From dashboard.razorpay.com → Account & Settings → API Keys. Use rzp_test_… keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

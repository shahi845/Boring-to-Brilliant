{
  "name": "ourcampus",
  "version": "1.0.0",
  "private": true,
  "description": "OURCAMPUS — role-based campus management: attendance, leave, requests, fees, lab and library.",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:db": "sh tests/db/run.sh",
    "format": "prettier --write \"src/**/*.{js,css}\" \"server/**/*.js\" \"tests/**/*.js\" index.html",
    "lint": "prettier --check \"src/**/*.{js,css}\" \"server/**/*.js\" \"tests/**/*.js\"",
    "accounts:create": "node --env-file=.env server/scripts/create-accounts.mjs",
    "design:export": "node scripts/export-design.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "vite": "^6.0.7"
  }
}
